```gitignore
# ============================================================
# Visual Studio / .NET
# ============================================================

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/

# Visual Studio cache/options
.vs/
.vscode/
*.user
*.userosscache
*.suo
*.userprefs
*.rsuser
*.sln.docstates

# Visual Studio generated files
*.ncb
*.aps
*.pdb
*.ilk
*.opendb
*.VC.db

# Visual Studio profiling
*.psess
*.vsp
*.vspx
*.sap

# ============================================================
# .NET
# ============================================================

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
!**/[Pp]ackages/repositories.config

# NuGet generated files
project.lock.json
project.fragment.lock.json
artifacts/

# .NET Core / ASP.NET generated files
wwwroot/lib/
Generated/
generated/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Code coverage
coverage/
.coverage/
*.opencover.xml

# ============================================================
# ASP.NET Core
# ============================================================

# Local configuration
appsettings.Local.json
appsettings.*.Local.json

# Development certificates
*.pfx
*.p12

# Local HTTPS certificates
aspnetcore-https.pfx

# User secrets
secrets.json

# ============================================================
# Logs
# ============================================================

*.log
logs/
Log/
Logs/

# ============================================================
# Database / Local development
# ============================================================

*.mdf
*.ldf
*.ndf

# SQLite databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ============================================================
# Entity Framework
# ============================================================

# EF migration generated database snapshots are NOT ignored.
# Keep migrations under source control.

# ============================================================
# JetBrains Rider / ReSharper
# ============================================================

.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper*
*.DotSettings.user

# ============================================================
# Windows
# ============================================================

Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================
# macOS
# ============================================================

.DS_Store
.AppleDouble
.LSOverride

# ============================================================
# Temporary files
# ============================================================

*.tmp
*.temp
*.bak
*.swp
*.orig
*~

# ============================================================
# Publish output
# ============================================================

publish/
Publish/
*.publishsettings

# ============================================================
# Docker
# ============================================================

docker-compose.override.yml

# ============================================================
# Local environment variables / secrets
# ============================================================

.env
.env.*
!.env.example

# ============================================================
# Node files (if Web/Mobile projects are in the same repo)
# ============================================================

node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite
dist/

# Expo / React Native
.expo/
.expo-shared/
web-build/
.metro-health-check*
*.jks
*.keystore

# ============================================================
# OS / IDE temporary files
# ============================================================

*.pid
*.seed
*.pid.lock
```
